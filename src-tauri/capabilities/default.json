{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Work Todo 主窗口的最小文件备份权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
